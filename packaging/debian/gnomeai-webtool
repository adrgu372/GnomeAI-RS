#!/bin/sh
set -eu

if [ -n "${XDG_STATE_HOME:-}" ]; then
    state_root=$XDG_STATE_HOME/gnomeai-rs
else
    state_root=${HOME:?HOME is not set}/.local/state/gnomeai-rs
fi
mkdir -p "$state_root"

url=http://127.0.0.1:8787
if ! curl --fail --silent --max-time 2 "$url/" >/dev/null 2>&1; then
    nohup /usr/bin/gnomef-web </dev/null >>"$state_root/webtool.log" 2>&1 &
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if curl --fail --silent --max-time 2 "$url/" >/dev/null 2>&1; then
            break
        fi
        attempt=$((attempt + 1))
        sleep 0.5
    done
fi

if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$url"
fi
echo "$url"

