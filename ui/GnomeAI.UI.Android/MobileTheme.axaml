<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MobilePage" Color="#10191E" />
          <SolidColorBrush x:Key="MobileText" Color="#EEF4F0" />
          <SolidColorBrush x:Key="MobileMuted" Color="#93A59F" />
          <SolidColorBrush x:Key="MobileControl" Color="#202C32" />
          <SolidColorBrush x:Key="MobileInput" Color="#182329" />
          <SolidColorBrush x:Key="MobileBorder" Color="#35453F" />
          <SolidColorBrush x:Key="MobileHover" Color="#2A3D40" />
          <SolidColorBrush x:Key="MobilePressed" Color="#35534F" />
          <SolidColorBrush x:Key="MobileActive" Color="#233B32" />
          <SolidColorBrush x:Key="MobileActiveText" Color="#B4EFCF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MobilePage" Color="#F5F8F6" />
          <SolidColorBrush x:Key="MobileText" Color="#172B23" />
          <SolidColorBrush x:Key="MobileMuted" Color="#536B5E" />
          <SolidColorBrush x:Key="MobileControl" Color="#EAF0EC" />
          <SolidColorBrush x:Key="MobileInput" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MobileBorder" Color="#CAD9D0" />
          <SolidColorBrush x:Key="MobileHover" Color="#DDE9E2" />
          <SolidColorBrush x:Key="MobilePressed" Color="#C9E0D2" />
          <SolidColorBrush x:Key="MobileActive" Color="#D6EBDE" />
          <SolidColorBrush x:Key="MobileActiveText" Color="#1C5B39" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="UserControl">
    <Setter Property="Foreground" Value="{DynamicResource MobileText}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Background" Value="{DynamicResource MobileControl}" />
    <Setter Property="Foreground" Value="{DynamicResource MobileText}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MobileHover}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MobilePressed}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Background" Value="#A5E3C5" />
    <Setter Property="Foreground" Value="#11251C" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>
  <Style Selector="Button.send:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#77C9A4" />
    <Setter Property="Foreground" Value="#11251C" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MobileMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,8" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource MobileActive}" />
    <Setter Property="Foreground" Value="{DynamicResource MobileActiveText}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource MobileInput}" />
    <Setter Property="Foreground" Value="{DynamicResource MobileText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MobileBorder}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#A5E3C5" />
  </Style>
  <Style Selector="TextBox.composer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource MobileControl}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <!-- Fluent sets template background on focus; override it for both themes. -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MobileInput}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource MobileText}" />
    <Setter Property="CaretBrush" Value="{DynamicResource MobileText}" />
  </Style>
  <Style Selector="TextBox.composer /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
