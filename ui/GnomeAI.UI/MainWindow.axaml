<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GnomeAI.UI"
        x:Class="GnomeAI.UI.MainWindow"
        x:Name="Root"
        Title="GnomeAI-RS"
        Width="1280" Height="820"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
  <Border x:Name="RootBackground" Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="48,*">
      <!-- Windows App SDK-inspired title surface. The operating-system window
           controls remain native on every Avalonia platform. -->
      <Border Grid.Row="0" Background="{DynamicResource NavigationBackgroundBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="180,*,Auto" Margin="16,0,18,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="G" Foreground="White" FontSize="16" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="GnomeAI-RS" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <ComboBox x:Name="DevicePicker" Grid.Column="1" MinWidth="150" MaxWidth="240" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="Choose the device whose conversations you want to open" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button x:Name="AgentTabButton" Content="Agent" Padding="10,4" MinHeight="28"
                      ToolTip.Tip="Coding agent conversations" Click="AgentTab_Click" />
              <Button x:Name="ChatTabButton" Content="Chat" Padding="10,4" MinHeight="28"
                      ToolTip.Tip="End-to-end encrypted messenger" Click="ChatTab_Click" />
            </StackPanel>
            <TextBlock x:Name="ConnectionText" Text="Connecting to the Rust core…" MaxWidth="170" TextTrimming="CharacterEllipsis"
                       FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="VersionText" Text="Avalonia" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="ThemeButton" Classes="icon" Width="30" MinWidth="30" MaxWidth="30"
                    Height="30" MinHeight="30" MaxHeight="30" Content="☾"
                    ToolTip.Tip="Switch to dark theme" Click="Theme_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="DesktopWorkspace" Grid.Row="1" ColumnDefinitions="280,*,Auto">
        <!-- Navigation pane -->
        <Border x:Name="SidebarPane" Grid.Column="0" Background="{DynamicResource NavigationBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,12,12,14">
            <Button Grid.Row="0" Classes="accent" HorizontalContentAlignment="Center" Click="NewSession_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="＋" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="New conversation" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBox x:Name="SessionSearch" Grid.Row="1" Margin="0,12,0,10" Watermark="Search conversations"
                     TextChanged="SessionSearch_TextChanged" />

            <TextBlock Grid.Row="2" Classes="section" Text="CONVERSATIONS" Margin="6,0,0,6" />

            <Grid Grid.Row="3" RowDefinitions="*,Auto">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:SessionItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <Button Classes="nav" Tag="{Binding Id}" Click="ResumeSession_Click">
                          <StackPanel>
                            <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" FontSize="13" />
                            <TextBlock Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis"
                                       FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="sessionClose" Tag="{Binding Id}" Content="×"
                                ToolTip.Tip="Delete conversation"
                                Click="DeleteSession_Click" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button Grid.Row="1" Classes="nav" Click="AllSessions_Click">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                  <TextBlock Classes="navIcon" Text="⋯" />
                  <TextBlock Grid.Column="1" Text="All conversations" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </Grid>

            <StackPanel Grid.Row="4" Spacing="2" Margin="0,9,0,0">
              <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,6" />
              <Button x:Name="WorkspaceButton" Classes="nav" Click="Workspace_Click">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                  <TextBlock Classes="navIcon" Text="▣" />
                  <TextBlock x:Name="WorkspaceLabel" Grid.Column="1" Text="Choose project" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button x:Name="ModelButton" Classes="nav" Click="Model_Click">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                  <TextBlock Classes="navIcon" Text="◇" />
                  <TextBlock x:Name="ModelLabel" Grid.Column="1" Text="Model" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Classes="nav" Click="WhatsApp_Click">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                  <TextBlock Classes="navIcon" Text="◉" />
                  <TextBlock Grid.Column="1" Text="WhatsApp" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="nav" Click="Devices_Click">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                  <TextBlock Classes="navIcon" Text="⌘" />
                  <TextBlock Grid.Column="1" Text="Devices" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="nav" Click="Settings_Click">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                  <TextBlock Classes="navIcon" Text="⚙" />
                  <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main conversation -->
        <Grid x:Name="ChatWorkspace" Grid.Column="1" RowDefinitions="88,*,Auto" Background="{DynamicResource ContentBackgroundBrush}">
          <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,15,24,15">
              <Button x:Name="SidebarToggle" Classes="icon" Content="☰" Width="30" MinWidth="30" MaxWidth="30"
                      ToolTip.Tip="Show or hide the sidebar" Click="SidebarToggle_Click" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock x:Name="ConversationTitle" Text="New conversation" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="WorkspaceText" Text="Choose a project folder to begin"
                           Classes="muted" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button x:Name="MoveSessionButton" Content="Move / Sync" IsVisible="false" Click="MoveDevice_Click" />
                <Button x:Name="ProviderButton" Content="Provider" Click="Provider_Click" />
                <Button x:Name="SearchButton" Content="Web search" Click="Search_Click" />
                <Button Content="Changes" Click="Activity_Click" />
                <Button Classes="icon" Content="?" ToolTip.Tip="Commands and shortcuts" Click="Help_Click" />
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="TranscriptSurface" Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
            <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                          IsScrollChainingEnabled="False" BringIntoViewOnFocusChange="False"
                          Padding="24,18,24,44">
              <StackPanel x:Name="TranscriptContent" MaxWidth="920"
                          HorizontalAlignment="Stretch" Margin="0,0,0,18">
                <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" Margin="0,46,0,22" Spacing="10">
                  <Border Width="50" Height="50" CornerRadius="25" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="G" Foreground="White" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="What are we working on today?" FontSize="25" FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="Ask for a change, attach a file, or choose a quick action."
                             Classes="muted" HorizontalAlignment="Center" />
                  <StackPanel Spacing="7" Margin="0,12,0,0" Width="520">
                    <Button Tag="Analyze the current project and tell me what should be improved."
                            Click="Suggestion_Click" HorizontalContentAlignment="Left">
                      <StackPanel>
                        <TextBlock Text="Analyze the current project" FontWeight="SemiBold" />
                        <TextBlock Text="Structure, issues, and improvements" FontSize="11" Classes="muted" />
                      </StackPanel>
                    </Button>
                    <Button Click="ShowChangesSuggestion_Click" HorizontalContentAlignment="Left">
                      <StackPanel>
                        <TextBlock Text="Show Git changes" FontWeight="SemiBold" />
                        <TextBlock Text="Changed files and diff" FontSize="11" Classes="muted" />
                      </StackPanel>
                    </Button>
                    <Button Click="ConfigureWhatsAppSuggestion_Click" HorizontalContentAlignment="Left">
                      <StackPanel>
                        <TextBlock Text="Configure WhatsApp" FontWeight="SemiBold" />
                        <TextBlock Text="Connection, QR pairing, and allowed numbers" FontSize="11" Classes="muted" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:MessageItem">
                      <Border Classes="card" Background="{Binding CardBrush}"
                              HorizontalAlignment="{Binding Alignment}" MaxWidth="860" MinWidth="280">
                        <StackPanel Spacing="7">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10"
                                       Foreground="{DynamicResource SuccessBrush}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Images}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><local:ConversationPhoto DataUri="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <local:MarkdownView SelectionModeChanged="ResponseSelectionChanged" Markdown="{Binding Text}" IsVisible="{Binding IsNotCollapsible}" />
                          <ToggleButton Classes="details" IsVisible="{Binding IsCollapsible}"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <TextBlock Text="{Binding DetailsLabel}" FontSize="12" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding DetailsChevron}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                          </ToggleButton>
                          <local:MarkdownView SelectionModeChanged="ResponseSelectionChanged" Markdown="{Binding Text}" IsVisible="{Binding IsExpanded}" />
                          <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="local:MessageAction">
                                <Button Content="{Binding Label}" Command="{Binding Run}" Margin="0,3"
                                        HorizontalAlignment="Left" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel Spacing="6" IsVisible="{Binding HasInput}">
                            <TextBlock Text="{Binding InputHint}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                            <TextBox Text="{Binding InputValue}" PasswordChar="•" Watermark="Enter the credential" />
                            <CheckBox IsVisible="{Binding InputRememberVisible}" IsChecked="{Binding InputRemember}"
                                      Content="Remember in the system keyring" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Keep roughly three text lines of follow space above the composer. -->
                <Border x:Name="TranscriptBottomAnchor" Height="72" />
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                  Padding="20,10,20,15">
            <StackPanel MaxWidth="940" HorizontalAlignment="Center" Spacing="7">
              <Border x:Name="SlashPopup" IsVisible="False" Classes="surface" Padding="6">
                <ItemsControl ItemsSource="{Binding SlashSuggestions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:SlashCommandEntry">
                      <Button Classes="nav" Tag="{Binding Command}" Click="SlashSuggestion_Click">
                        <Grid ColumnDefinitions="120,*">
                          <TextBlock Text="{Binding Command}" FontFamily="monospace" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding Description}" Classes="muted" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <Border x:Name="AttachmentBar" IsVisible="False"
                      Background="{DynamicResource NavigationBackgroundBrush}" CornerRadius="6" Padding="10,6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="AttachmentText" Text="Attachment" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Remove" Padding="8,3" MinHeight="28" Click="RemoveAttachment_Click" />
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="AttachButton" Classes="icon composerAction" Content="＋" ToolTip.Tip="Attach a file" Click="Attach_Click" />
                <TextBox x:Name="Composer" Grid.Column="1" Classes="composer" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="50" MaxHeight="176" Watermark="Ask GnomeAI…"
                         TextChanged="Composer_TextChanged" />
                <Button x:Name="SendButton" Grid.Column="2" Classes="accent composerAction" Content="Send" MinWidth="84"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Send_Click" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock x:Name="QueueText" Text="Enter sends · Shift+Enter inserts a new line"
                             VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                  <Button x:Name="ResumeQueueButton" Content="Resume queue" IsVisible="False"
                          Padding="6,2" MinHeight="22" FontSize="10" Click="ResumeQueue_Click" />
                  <Button x:Name="ClearQueueButton" Content="Clear queue" IsVisible="False"
                          Padding="6,2" MinHeight="22" FontSize="10" Click="ClearQueue_Click" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TokenText" Text="0 input · 0 output"
                           FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Activity / changes pane -->
        <Border x:Name="ActivityPane" Grid.Column="2" IsVisible="False" Width="350"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1,0,0,0">
          <Grid RowDefinitions="Auto,Auto,*" Margin="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ChangesTitle" Text="Changes (0)" FontSize="18" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icon" Content="×" Click="CloseActivity_Click" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7" Margin="0,10,0,10">
              <Button Content="Refresh diff" Click="RefreshDiff_Click" />
              <Button Content="Skills" Click="Skills_Click" />
              <Button Content="Memory" Click="Memory_Click" />
              <Button Content="Diagnostics" Click="Doctor_Click" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="9">
                <TextBlock Classes="section" Text="FILES" />
                <ItemsControl ItemsSource="{Binding ChangedFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="5" Padding="8,6" Margin="0,2">
                        <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="section" Text="DIFF PREVIEW" Margin="0,6,0,0" />
                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="300">
                    <TextBox x:Name="DiffPreview" Classes="readonly" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="monospace" FontSize="11"
                             Text="There are no changes in this session yet." />
                  </ScrollViewer>
                </Border>
                <TextBlock Classes="section" Text="ACTIVITY" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding ActivityItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:ActivityItem">
                      <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,5,0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Details}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <ContentControl x:Name="DevicesPage" Grid.Column="1" IsVisible="false" Background="{DynamicResource ContentBackgroundBrush}" />

        <!-- Chat: end-to-end encrypted messenger over Tor. A separate surface
             from the agent workspace so switching between them is instant and
             no coding-agent state is touched. -->
        <Grid x:Name="ChatPage" Grid.Column="1" ColumnDefinitions="290,*" IsVisible="False"
              Background="{DynamicResource ContentBackgroundBrush}">
          <Border Grid.Column="0" Background="{DynamicResource NavigationBackgroundBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="12,12,12,12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox x:Name="MessengerAccountPicker" Grid.Column="0"
                          HorizontalAlignment="Stretch" MinHeight="30"
                          ToolTip.Tip="Switch messenger account instantly; each account has its own identity and onion"
                          SelectionChanged="MessengerAccount_SelectionChanged" />
                <Button x:Name="MessengerNewAccountButton" Grid.Column="1" Classes="icon"
                        Content="＋" Width="30" MinWidth="30" MaxWidth="30"
                        ToolTip.Tip="Create another messenger account" Click="MessengerNewAccount_Click" />
              </Grid>
              <TextBox x:Name="MessengerSearch" Grid.Row="1" Margin="0,10,0,8"
                       Watermark="Search conversations" TextChanged="MessengerSearch_TextChanged" />
              <!-- Scanned-but-unanswered invites. A QR scan is a question for
                   the other device, so it is shown before any conversation. -->
              <StackPanel x:Name="MessengerRequests" Grid.Row="2" Spacing="0" IsVisible="False"
                          Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Classes="section" Text="CHATS" Margin="6,0,0,6" />
              <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessengerConversations">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:MessengerConversationItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <Button Classes="nav" Tag="{Binding Id}" Click="MessengerConversation_Click"
                                HorizontalContentAlignment="Stretch">
                          <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                              <TextBlock Text="{Binding Badge}" FontSize="11" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="2" Background="{DynamicResource AccentBrush}"
                                      CornerRadius="9" Padding="6,1" IsVisible="{Binding HasUnread}">
                                <TextBlock Text="{Binding UnreadLabel}" Foreground="White" FontSize="10" />
                              </Border>
                            </Grid>
                            <TextBlock Text="{Binding Preview}" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Grid.Row="5" Spacing="2" Margin="0,8,0,0">
                <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,6" />
                <Button Classes="nav" Click="MessengerAddContact_Click">
                  <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                    <TextBlock Classes="navIcon" Text="＋" />
                    <TextBlock Grid.Column="1" Text="Add contact" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav" Click="MessengerGroups_Click">
                  <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                    <TextBlock Classes="navIcon" Text="⋯" />
                    <TextBlock Grid.Column="1" Text="Groups" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav" Click="MessengerProfile_Click">
                  <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                    <TextBlock Classes="navIcon" Text="◎" />
                    <TextBlock x:Name="MessengerProfileLabel" Grid.Column="1" Text="My profile"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="18,12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock x:Name="MessengerTitle" Text="Chat" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock x:Name="MessengerSubtitle" Classes="muted" FontSize="11"
                             Text="Encrypted peer-to-peer over Tor · no server, no relay" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <Button x:Name="MessengerEditButton" Content="Edit" IsVisible="False"
                          ToolTip.Tip="Edit a text message you sent" Click="MessengerEdit_Click" />
                  <Button Classes="icon" Content="?" ToolTip.Tip="Messenger commands and limits"
                          Click="MessengerHelp_Click" />
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="MessengerBanner" Grid.Row="1" IsVisible="False" Padding="14,7"
                    Background="{DynamicResource NavigationBackgroundBrush}">
              <TextBlock x:Name="MessengerBannerText" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedTextBrush}" />
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource ContentBackgroundBrush}">
              <ScrollViewer x:Name="MessengerScroll" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalContentAlignment="Stretch"
                            IsScrollChainingEnabled="False"
                            Padding="20,14,20,28">
                <StackPanel x:Name="MessengerTranscript" MaxWidth="880" Spacing="10"
                            HorizontalAlignment="Stretch">
                  <StackPanel x:Name="MessengerEmptyState" Spacing="8" Margin="0,40,0,18"
                              HorizontalAlignment="Center">
                    <TextBlock Text="No account yet" FontSize="21" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="460" TextAlignment="Center"
                               Text="Create a messenger account to get an encrypted identity and its own onion address. Nothing leaves this device unencrypted." />
                    <Button Classes="accent" Content="Create account" HorizontalAlignment="Center"
                            Click="MessengerNewAccount_Click" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,9,18,13">
              <StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="MessengerTransferBar" IsVisible="False" Padding="9,6"
                        Background="{DynamicResource NavigationBackgroundBrush}" CornerRadius="6">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="MessengerTransferLabel" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Content="Cancel" Padding="7,2" MinHeight="22"
                              FontSize="10" Click="MessengerCancelTransfer_Click" />
                    </Grid>
                    <ProgressBar x:Name="MessengerTransferProgress" Height="4" Minimum="0" Maximum="1"
                                 Value="0" />
                  </StackPanel>
                </Border>
                <Border x:Name="MessengerReplyBar" IsVisible="False" Padding="9,6"
                        Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="MessengerReplyText" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="icon" Content="×" Width="24" MinWidth="24"
                            Height="22" MinHeight="22" Click="MessengerCancelReply_Click" />
                  </Grid>
                </Border>
                <Border x:Name="MessengerAttachmentBar" IsVisible="False" Padding="9,6"
                        Background="{DynamicResource NavigationBackgroundBrush}" CornerRadius="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="MessengerAttachmentText" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Remove" Padding="7,2" MinHeight="22"
                            FontSize="10" Click="MessengerRemoveAttachment_Click" />
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Button x:Name="MessengerAttachButton" Classes="icon composerAction" Content="＋"
                          ToolTip.Tip="Attach a photo, video, audio file or document"
                          Click="MessengerAttach_Click" />
                  <TextBox x:Name="MessengerComposer" Grid.Column="1" Classes="composer"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="160"
                           Watermark="Write a message… (Markdown supported)"
                           KeyDown="MessengerComposer_KeyDown" />
                  <Button x:Name="MessengerSendButton" Grid.Column="2" Classes="accent composerAction"
                          Content="Send" MinWidth="78" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" Click="MessengerSend_Click" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="MessengerHint" FontSize="10"
                             Foreground="{DynamicResource MutedTextBrush}"
                             Text="Enter sends · Shift+Enter inserts a new line" />
                  <TextBlock Grid.Column="1" x:Name="MessengerStatus" FontSize="10"
                             Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
